PORT=3000
# Lokal: opsional. Di Railway volume terdeteksi otomatis melalui RAILWAY_VOLUME_MOUNT_PATH.
DB_PATH=./data/orders.db

# Login. Jika APP_PASSWORD kosong, login dimatikan (cocok untuk localhost saja).
APP_USERNAME=admin
APP_PASSWORD=
SESSION_SECRET=

# Set false/0 untuk database production kosong tanpa dummy supplier/product/order.
SEED_SAMPLE_DATA=1

# Optional fallback. URL Google Sheets juga dapat disimpan dari menu Reports.
GOOGLE_SHEETS_WEBHOOK_URL=
